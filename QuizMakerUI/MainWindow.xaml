<Window x:Class="QuizMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizMaker"
        mc:Ignorable="d"
        Title="MainWindow" 
        MinHeight="450" MinWidth="800"
        Background="#1E1E2E">
    <Grid Height="450" Width="800">
        <Frame x:Name="MainFrame"
       NavigationUIVisibility="Hidden"/>
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="320">
            <StackPanel>
                <TextBlock Text="QuizMaker" FontSize="12"
                           Foreground="{StaticResource SubtextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Login" FontSize="26" FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Margin="0,4,0,20"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Username" VerticalAlignment="Center"
                               FontSize="14" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Margin="0,8,0,8" 
                             FontSize="14"
                             x:Name="Username"/>

                    <TextBlock Grid.Row="1" Text="Password" 
                           VerticalAlignment="Center"
                           FontSize="14" Margin="0,0,10,0"/>
                    <PasswordBox Grid.Row="1" Grid.Column="1" 
                             Margin="0,8,0,8" 
                             FontSize="14" x:Name="Password"
                             PasswordChanged="Password_PasswordChanged"/>
                    <TextBox Grid.Row="1" Grid.Column="1" 
                             Margin="0,8,0,8" FontSize="14"
                             x:Name="PasswordText" Visibility="Collapsed"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="👁" 
                        Margin="0,8,0,8"
                        x:Name="ButtonShowPassword"
                        Click="ButtonShowPassword_Click"
                        Style="{StaticResource SecondaryButton}"/>
                </Grid>
                <TextBlock Margin="0,8,0,8"/>
                <Button Content="Login" FontSize="15" FontWeight="SemiBold"
                        Click="Button_Login" 
                        Style="{StaticResource PrimaryButton}"/>
                <TextBlock Margin="0,4"/>
                <Button Content="Register" FontSize="13" Margin="80,0"
                    Click="Button_Register" 
                    Style="{StaticResource SecondaryButton}"/>
                <TextBlock Margin="0,4" />
                <Button Content="Delete Account" FontSize="13" 
                    Margin="80,0"
                    x:Name="ButtonDeleteAccount"
                    Click="ButtonDeleteAccount_Click"
                    Style="{StaticResource DangerButton}"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
