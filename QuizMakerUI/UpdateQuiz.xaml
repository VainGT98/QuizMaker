<Page x:Class="QuizMakerUI.UpdateQuiz"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QuizMakerUI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UpdateQuiz"
      Background="White">

    <Grid Width="800" Height="450">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Update Quiz" FontSize="30" 
                   HorizontalAlignment="Center" 
                   Grid.ColumnSpan="3"/>
        <TextBlock Grid.Row="1" Text="Quiz Title:" 
                   VerticalAlignment="Center"
                   FontSize="21" FontWeight="Bold"
                   Margin="20,0,0,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                 Margin="10,150,10,150" x:Name="QuizTitle"/>

        <Button Grid.Row="2" Grid.Column="1" Content="Cancel"
                FontSize="20" Margin="350,10,20,10" x:Name="Cancel"
                Click="Cancel_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Content="Save"  
                Margin="20,10,20,10" FontSize="20" 
                x:Name="ButtonSave" Click="ButtonSave_Click"/>
        <Button Grid.Row="2" Grid.Column="3" Content="Next"
                FontSize="20" Margin="10" x:Name="Next"
                Click="Next_Click"/>
    </Grid>
</Page>
