<Page x:Class="QuizMakerUI.AdminInterface"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QuizMakerUI"
      mc:Ignorable="d" 
      MinHeight="450" MinWidth="800"
      Title="AdminInterface"
      Background="#1E1E2E">

    <Grid Height="450" Width="800">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="ADMIN INTERFACE" FontSize="30" TextAlignment="Center"
                   Grid.ColumnSpan="2"/>

        <DataGrid Grid.Row="1" x:Name="UsersGrid" 
                  Margin="15,0,15,15" AutoGenerateColumns="False"
                  SelectionChanged="UsersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" 
                                    Binding="{Binding Username}"/>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Grid.Row="1" Grid.Column="1" x:Name="RolesGrid" 
                   Margin="15,0,15,15" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Role" 
                                    Binding="{Binding RoleName}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Back" Grid.Row="2" Grid.Column="1"
                FontSize="16" Padding="10" Margin="300,0,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Command="{Binding BackCommand}"
                Click="BackButton_Click"
                x:Name="BackButton"
                Style="{StaticResource DangerButton}"/>
    </Grid>
</Page>
