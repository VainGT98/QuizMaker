<Page x:Class="QuizMaker.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QuizMaker"
      mc:Ignorable="d" 
      MinHeight="450" MinWidth="800"
      Title="Register"
      Background="#1E1E2E">

    <Grid Height="450" Width="800">
        <StackPanel Margin="250,100">
            <TextBlock Text="Register" FontSize="25" HorizontalAlignment="Center"/>
            <TextBlock/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Username" VerticalAlignment="Center"
                    FontSize="16"/>
                <TextBox Grid.Column="1" Margin="10,10,0,10" FontSize="16"
                    x:Name="Username"/>

                <TextBlock Grid.Row="1" Text="Password" 
                    VerticalAlignment="Center"
                    FontSize="16"/>
                <PasswordBox Grid.Row="1" Grid.Column="1" Margin="10,10,0,10" 
                             FontSize="16" x:Name="Password"
                             PasswordChanged="Password_PasswordChanged"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="10,10,0,10" 
                         FontSize="16"
                         x:Name="PasswordText" Visibility="Collapsed"/>
                <Button Grid.Row="1" Grid.Column="2" Content="👁" 
                        Margin="0,10,0,10"
                        x:Name="ButtonShowPassword"
                        Click="ButtonShowPassword_Click"
                        Style="{StaticResource SecondaryButton}"/>
            </Grid>
            <TextBlock/>
            <Button Content="Register" FontSize="16" Margin="15,0"
                    Click="Button_Register"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Page>
