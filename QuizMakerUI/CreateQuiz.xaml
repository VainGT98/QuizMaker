<Page x:Class="QuizMakerUI.CreateQuiz"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QuizMakerUI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreateQuiz"
      Background="White">

    <Grid Width="800" Height="450">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Create Quiz" FontSize="30" 
                   HorizontalAlignment="Center" 
                   Grid.ColumnSpan="3"/>
        <TextBlock Grid.Row="1" Text="Quiz Title:" 
                   VerticalAlignment="Center"
                   FontSize="21" FontWeight="Bold"
                   Margin="20,0,0,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" 
                 Margin="10,30,10,30" x:Name="QuizTitle"/>
        <TextBlock Grid.Row="2" Text="Question Number:" 
                   VerticalAlignment="Center"
                   FontSize="15" FontWeight="Bold"
                   Margin="5,0,0,0"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Margin="10,30,450,30" x:Name="QuestionNumber"/>
        <TextBlock Grid.Row="3" Text="Answer Number:" 
                   VerticalAlignment="Center"
                   FontSize="15" FontWeight="Bold"
                   Margin="5,0,0,0"/>
        <ComboBox Grid.Row="3" Grid.Column="1" 
                  Margin="10,30,450,30" x:Name="AnswerNumber">
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
        </ComboBox>
        <Button Grid.Row="4" Grid.Column="1" Content="Cancel" 
                HorizontalAlignment="Center" Margin="400,20,0,20"
                FontSize="25" Padding="10" x:Name="ButtonCancel" 
                Click="ButtonCancel_Click"/>
        <Button Grid.Row="4" Grid.Column="2" Content="Next" 
                HorizontalAlignment="Center" Margin="0,20,0,20"
                FontSize="25" Padding="10" x:Name="ButtonNext" 
                Click="ButtonNext_Click"/>
    </Grid>
</Page>
